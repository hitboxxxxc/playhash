rules_version = '2';

// PlayHash — Firestore Security Rules (menor privilégio).
//
// MODELO: "cliente escreve INTENÇÕES validadas; admin (runner) escreve ECONOMIA".
//  - Cliente cria gameSessions (abre/fecha a própria sessão com campos exatos)
//    e purchaseIntents (intenção de compra). NADA mais.
//  - wallets, power, machines, transactions, auditLogs, blocks, config,
//    tempGrants, rateLimits: escrita SOMENTE via Admin SDK (bypassa rules).
//  - O runner (GitHub Actions) é a ÚNICA autoridade econômica.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Timestamp ≈ agora, com tolerância de relógio (±2 min).
    function withinTolerance(ts) {
      return ts is timestamp
        && ts >= request.time - duration.value(120, 's')
        && ts <= request.time + duration.value(120, 's');
    }

    function dayKey() {
      return '' + request.time.year() + '-' + request.time.month() + '-' + request.time.day();
    }

    // Cota diária de intenções (contador mantido PELO BACKEND em rateLimits/{uid}).
    // Doc ausente => primeira intenção do dia é permitida; o backend passa a
    // incrementar a partir daí. Janela de corrida aceitável (documentada).
    function dailyQuotaOk(uid, prefix, limit) {
      let k = prefix + '_' + dayKey();
      return !exists(/databases/$(database)/documents/rateLimits/$(uid))
        || get(/databases/$(database)/documents/rateLimits/$(uid)).data[k] < limit;
    }

    // ---- Perfil do usuário -------------------------------------------
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'photoUrl', 'createdAt', 'lastLoginAt',
          'status', 'settings', 'termsAcceptedAt'
        ]);
      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'displayName', 'photoUrl', 'lastLoginAt', 'settings'
        ]);
      allow delete: if false;
    }

    // ---- Documentos econômicos: SOMENTE LEITURA do dono ---------------
    match /wallets/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /power/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /machines/{uid}/items/{itemId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /userMissions/{uid}/items/{missionId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /userAchievements/{uid}/items/{achievementId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /userLeagues/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /seasonProgress/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ---- Catálogos públicos: leitura para autenticados -----------------
    match /games/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /missions/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /achievements/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /leagues/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /seasons/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---- Sessões de partida: cliente escreve INTENÇÃO validada ---------
    match /gameSessions/{sessionId} {
      allow read: if isSignedIn()
        && resource.data.uid == request.auth.uid;

      // CREATE: campos EXATOS de abertura; startedAt ≈ agora; game habilitado.
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['uid', 'gameId', 'startedAt', 'clientVersion', 'status'])
        && request.resource.data.status == 'open'
        && request.resource.data.gameId is string
        && request.resource.data.gameId.size() > 0
        && request.resource.data.gameId.size() <= 64
        && request.resource.data.clientVersion is string
        && request.resource.data.clientVersion.size() <= 32
        && withinTolerance(request.resource.data.startedAt)
        && exists(/databases/$(database)/documents/games/$(request.resource.data.gameId))
        && get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.enabled == true;

      // UPDATE: owner, UMA vez, open→finished, score inteiro dentro da
      // configuração do game, finishedAt ≈ agora. Campos admin (processed,
      // serverResult) JAMAIS escritos pelo cliente.
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'open'
        && request.resource.data.status == 'finished'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['status', 'score', 'finishedAt'])
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <=
             get(/databases/$(database)/documents/games/$(resource.data.gameId))
               .data.configuration.maxExpectedScore
        && withinTolerance(request.resource.data.finishedAt);

      allow delete: if false;
    }

    // ---- Intenções de compra: cliente só CRIA a intenção ----------------
    match /purchaseIntents/{intentId} {
      allow read: if isSignedIn()
        && resource.data.uid == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['uid', 'machineId', 'clientRequestId', 'createdAt', 'status'])
        && request.resource.data.status == 'pending'
        && request.resource.data.machineId is string
        && request.resource.data.machineId.size() > 0
        && request.resource.data.machineId.size() <= 64
        && request.resource.data.clientRequestId is string
        && request.resource.data.clientRequestId.size() >= 8
        && request.resource.data.clientRequestId.size() <= 128
        && withinTolerance(request.resource.data.createdAt)
        && exists(/databases/$(database)/documents/config/machines/$(request.resource.data.machineId))
        && get(/databases/$(database)/documents/config/machines/$(request.resource.data.machineId)).data.enabled == true
        && dailyQuotaOk(request.auth.uid, 'pi', 20);

      allow update, delete: if false;
    }

    // ---- Rate limits: mantidos pelo backend; leitura apenas do dono -----
    match /rateLimits/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ---- Grants temporários: somente backend ----------------------------
    match /tempGrants/{grantId} {
      allow read: if isSignedIn()
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ---- Blocos e transações: leitura pública/dono, escrita backend -----
    match /blocks/{periodKey} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /transactions/{txId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /rewards/{rewardId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /withdrawals/{withdrawalId} {
      allow read: if isSignedIn()
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ---- Config interna: catálogo de máquinas legível; economia fechada --
    match /config/machines/{machineId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /config/{docId} {
      allow read, write: if false; // inclui config/economy
    }

    // ---- Auditoria: acesso somente via backend ---------------------------
    match /auditLogs/{logId} {
      allow read, write: if false;
    }

    // ---- Catch-all: NEGAR tudo que não foi explicitamente permitido ------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
