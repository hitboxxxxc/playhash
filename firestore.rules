rules_version = '2';

// PlayHash — Firestore Security Rules (menor privilégio).
//
// MODELO: "cliente escreve INTENÇÕES validadas; admin (runner) escreve ECONOMIA".
//  - Cliente cria gameSessions (abre/fecha a própria sessão com campos exatos)
//    e purchaseIntents (intenção de compra). NADA mais.
//  - wallets, power, machines, transactions, auditLogs, blocks, config,
//    tempGrants, rateLimits: escrita SOMENTE via Admin SDK (bypassa rules).
//  - O runner (GitHub Actions) é a ÚNICA autoridade econômica.
// EXCEÇÃO: máquinas e power podem ser atualizadas pelo cliente via transação imediata
// (compra/aprimorar de máquinas, decisão do dono).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Timestamp ≈ agora, com tolerância de relógio (±2 min).
    function withinTolerance(ts) {
      return ts is timestamp
        && ts >= request.time - duration.value(120, 's')
        && ts <= request.time + duration.value(120, 's');
    }

    // Dia UTC com ZERO-PAD — ALINHADO com o backend (ratelimit.utcDayKey =
    // ISO 'yyyy-MM-dd'). Antes as chaves nunca batiam ('2026-8-25' vs
    // '2026-08-25'), tornando o gate de cota inoperante.
    function padded2(n) {
      return n < 10 ? '0' + n : '' + n;
    }

    function dayKey() {
      return '' + request.time.year() + '-' + padded2(request.time.month()) + '-' + padded2(request.time.day());
    }

    // Teto de score do game: usa configuration.maxScore quando o game o define
    // (ex.: nova-swarm 30_000), senão o maxExpectedScore (games legados).
    function gameMaxScore(gameId) {
      let cfg = get(/databases/$(database)/documents/games/$(gameId)).data.configuration;
      return 'maxScore' in cfg ? cfg.maxScore : cfg.maxExpectedScore;
    }

    // Pontos por abate do game (0 = game sem contagem de inimigos/legado).
    function gamePointsPerKill(gameId) {
      let cfg = get(/databases/$(database)/documents/games/$(gameId)).data.configuration;
      return 'pointsPerKill' in cfg ? cfg.pointsPerKill : 0;
    }

    function gameCfgField(gameId, field, fallback) {
      let cfg = get(/databases/$(database)/documents/games/$(gameId)).data.configuration;
      return field in cfg ? cfg[field] : fallback;
    }

    function breakdownValid(gameId, b, score) {
      return b.keys().hasOnly(['stomps', 'coins', 'flagReached'])
        && b.stomps is int
        && b.stomps >= 0
        && b.stomps <= gameCfgField(gameId, 'maxStomps', 60)
        && b.coins is int
        && b.coins >= 0
        && b.coins <= gameCfgField(gameId, 'maxCoins', 40)
        && b.flagReached is bool
        && b.stomps * gameCfgField(gameId, 'pointsPerStomp', 0)
           + b.coins * gameCfgField(gameId, 'pointsPerCoin', 0)
           + (b.flagReached ? gameCfgField(gameId, 'flagBonus', 0) : 0)
           == score;
    }

    // kills consistente com o score: cada abate vale PELO MENOS
    // pointsPerKill (bônus só somam) ⇒ kills × pointsPerKill ≤ score.
    // Espelho EXATO da validação do runner (validateKillsConsistency).
    function killsConsistent(gameId, kills, score) {
      return kills == 0
        || (gamePointsPerKill(gameId) > 0 && kills * gamePointsPerKill(gameId) <= score);
    }

    // Cota diária de intenções (contador mantido PELO BACKEND em rateLimits/{uid}).
    // Doc ausente OU chave do dia ausente => permitido (o backend passa a
    // incrementar a partir daí). CORREÇÃO 12.8: acesso a chave INEXISTENTE de
    // map nas rules retorna ERRO (não null) — antes, qualquer usuário com doc
    // rateLimits criado por OUTRO contador (sessions/claims) recebia
    // PERMISSION_DENIED em TODA criação de intent (gate falso "bloqueado pela
    // configuração do servidor"). Checar `in` ANTES de comparar.
    // CORREÇÃO 12.12 (NULL-SAFE total): valor PRESENTE mas NÃO-numérico
    // (contador corrompido por outro writer) NÃO pode lançar erro na
    // comparação `<` ⇒ tratar como permitido (fail-open), igual aos casos
    // doc/chave ausentes. A porta de cota NUNCA nega a PRIMEIRA solicitação.
    // 12.18 — leitura tolerante de campo de saldo: saldos vivem como STRING
    // decimal (formato do backend); converte p/ int p/ comparação. Campo
    // ausente ou tipo inesperado conta como 0 (nunca lança erro).
    function balInt(d, k) {
      return !(k in d) ? 0
        : d[k] is int ? d[k]
        : d[k] is string ? int(d[k])
        : 0;
    }

    function dailyQuotaOk(uid, prefix, limit) {
      let k = prefix + '_' + dayKey();
      return !exists(/databases/$(database)/documents/rateLimits/$(uid))
        || !(k in get(/databases/$(database)/documents/rateLimits/$(uid)).data)
        || !(get(/databases/$(database)/documents/rateLimits/$(uid)).data[k] is number)
        || get(/databases/$(database)/documents/rateLimits/$(uid)).data[k] < limit;
    }

    // ---- Perfil do usuário -------------------------------------------
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'photoUrl', 'createdAt', 'lastLoginAt',
          'status', 'settings', 'termsAcceptedAt'
        ]);
      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'displayName', 'photoUrl', 'lastLoginAt', 'settings',
          'lastCheckinAt', 'machinesOn'
        ]);
      allow delete: if false;
    }

    // ---- Carteira ------------------------------------------------------
    // 12.18 — ANTI-INFLAÇÃO: o DONO pode atualizar a própria carteira
    // SOMENTE se (a) o total disponível+pendente NUNCA AUMENTAR e
    // (b) lifetimeEarned permanecer intacto. Reserva mantém a soma,
    // conclusão DIMINUI (dinheiro saiu), estorno mantém. Crédito continua
    // EXCLUSIVAMENTE pelo runner/Admin SDK (bypassa rules).
    // 14.11 — EXCEÇÃO COLETA OFFLINE: permite AUMENTO controlado do saldo
    // disponível (OfflineMiningService): teto 1.500.000.000 unidades
    // (1500 COIN) por coleta, lifetimeEarned cresce EXATAMENTE o delta do
    // saldo, pendingBalance intacto e lastAccumulatedAt estritamente
    // crescente (anti-replay). Saldos são STRING decimal ⇒ balInt().
    // 14.11-FIX2: lastAccumulatedAt agora é TIMESTAMP (o serviço grava
    // Timestamp.now()); primeira coleta aceita com campo ausente (null-safe).
    match /wallets/{uid} {
      allow read: if isOwner(uid);
      allow update: if isOwner(uid)
        && (
          // Regra original: nunca aumentar, lifetime intacto.
          (balInt(request.resource.data, 'availableBalance')
           + balInt(request.resource.data, 'pendingBalance')
          <= balInt(resource.data, 'availableBalance')
              + balInt(resource.data, 'pendingBalance')
          && balInt(request.resource.data, 'lifetimeEarned')
           == balInt(resource.data, 'lifetimeEarned'))
          ||
          // 14.11: aumento controlado da coleta offline.
          (balInt(request.resource.data, 'availableBalance')
             > balInt(resource.data, 'availableBalance')
          && balInt(request.resource.data, 'availableBalance')
             <= balInt(resource.data, 'availableBalance') + 1500000000
          && balInt(request.resource.data, 'lifetimeEarned')
             == balInt(resource.data, 'lifetimeEarned')
                + (balInt(request.resource.data, 'availableBalance')
                   - balInt(resource.data, 'availableBalance'))
          && balInt(request.resource.data, 'pendingBalance')
             == balInt(resource.data, 'pendingBalance')
          && 'lastAccumulatedAt' in request.resource.data
          && request.resource.data.lastAccumulatedAt is timestamp
          && (resource.data.lastAccumulatedAt == null
              || request.resource.data.lastAccumulatedAt > resource.data.lastAccumulatedAt))
        );
      allow create, delete: if false;
    }

    // ---- Poder ---------------------------------------------------------
    // permitir update imediato via transação (aprimorar power)
    match /power/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid);
      allow update: if (request.auth != null && request.auth.uid == uid
        && request.resource.data.totalPower
           == request.resource.data.permanentPower + request.resource.data.temporaryPower
        && (
          (request.resource.data.temporaryPower == resource.data.temporaryPower
           && request.resource.data.temporaryPowerExpiresAt == resource.data.temporaryPowerExpiresAt
           && request.resource.data.lastGrantAt == resource.data.lastGrantAt
           && request.resource.data.permanentPower >= resource.data.permanentPower)
          ||
          (request.resource.data.permanentPower == resource.data.permanentPower
           && request.resource.data.temporaryPower >= resource.data.temporaryPower
           && request.resource.data.temporaryPower <= resource.data.temporaryPower
              + get(/databases/$(database)/documents/config/economy).data.maxGamePowerPerSession
           && request.resource.data.lastGrantAt > request.time - duration.value(10, 'm')
           && request.resource.data.lastGrantAt < request.time + duration.value(10, 'm')
           && request.resource.data.temporaryPowerExpiresAt > request.time + duration.value(23, 'h')
           && request.resource.data.temporaryPowerExpiresAt < request.time + duration.value(25, 'h'))
        ));
    }

    // ---- Máquinas ------------------------------------------------------
    // permitir create/update imediato via transação (compra/aprimorar)
    match /machines/{uid}/items/{id} {
      allow read, create, update: if (request.auth != null && request.auth.uid == uid);
    }

    match /userMissions/{uid}/items/{missionId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /userAchievements/{uid}/items/{achievementId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /userLeagues/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /seasonProgress/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ---- Catálogos públicos: leitura para autenticados -----------------
    match /games/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /missions/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /achievements/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /leagues/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---- Ranking de ligas: mantido EXCLUSIVAMENTE pelo backend -----------
    // Entradas expõem APENAS maskedName (2 chars + '***') — nunca dados
    // pessoais. Leitura autenticada; escrita SOMENTE Admin SDK.
    match /leaderboards/{leagueId}/entries/{entryId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /seasons/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---- Sessões de partida: cliente escreve INTENÇÃO validada ---------
    // MINIMALISTA (doc 05 §35/§51, prompt 6.7): rules validam DONO+FORMATO;
    // economia (score/duração/breakdown/caps/quota) é validada SOMENTE no runner.
    match /gameSessions/{id} {
      allow create: if (request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.clientRequestId == id
        && request.resource.data.keys().hasOnly([
          'uid','gameId','clientRequestId','startedAt','finishedAt','status',
          'score','breakdown','durationMs','grantedPower','deviceGranted','clientVersion'
        ]));
      allow read: if (request.auth != null && resource.data.uid == request.auth.uid);
      allow update: if (request.auth != null && resource.data.uid == request.auth.uid);
    }

    // ---- Intenções de compra: cliente só CRIA a intenção ----------------
    // MINIMALISTA (doc 05 §35/§51): rules validam DONO+FORMATO; economia
    // (catálogo, status, quota, tolerância, size limits) é validada
    // SOMENTE no runner. update/delete do cliente são negados.
    match /purchaseIntents/{id} {
      allow create: if (request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.clientRequestId == id
        && request.resource.data.keys().hasOnly(
              ['uid', 'machineId', 'clientRequestId', 'createdAt', 'status']));
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // ---- Intenções de upgrade de máquina: cliente só CRIA a intenção ----
    // MINIMALISTA (doc 05 §35/§51): mesmas chaves; runner decide economia.
    match /machineUpgradeIntents/{id} {
      allow create: if (request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.clientRequestId == id
        && request.resource.data.keys().hasOnly(
              ['uid', 'machineId', 'clientRequestId', 'createdAt', 'status']));
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // ---- Claims (missões/conquistas): cliente só CRIA a intenção --------
    // Doc id = clientRequestId (UUID v4) ⇒ retry offline reescreve o MESMO
    // doc (idempotência; update é negado). A RECOMPENSA é concedida
    // EXCLUSIVAMENTE pelo runner (transação auditada) — nunca pelo cliente.
    match /claims/{claimId} {
      allow read: if isSignedIn()
        && resource.data.uid == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(
              ['uid', 'kind', 'refId', 'clientRequestId', 'createdAt', 'status'])
        && request.resource.data.status == 'pending'
        && (request.resource.data.kind == 'mission'
            || request.resource.data.kind == 'achievement'
            || request.resource.data.kind == 'seasonFree'
            || request.resource.data.kind == 'seasonPremium')
        && request.resource.data.refId is string
        && request.resource.data.refId.size() > 0
        && request.resource.data.refId.size() <= 64
        && request.resource.data.clientRequestId == claimId
        && request.resource.data.clientRequestId.size() >= 8
        && request.resource.data.clientRequestId.size() <= 128
        && withinTolerance(request.resource.data.createdAt);

      allow update, delete: if false;
    }

    // ---- Saques (12.18/12.20) -------------------------------------------
    // O CLIENTE grava o resultado do payout feito por ele mesmo (doc id =
    // clientRequestId). 12.20: status inicial pode ser 'pending' (MODO
    // MANUAL — operador paga e define 'completed'/'failed' pelo Console,
    // que BYPASSA rules). destinationMasked SEMPRE mascarado — o destino
    // completo nunca é persistido aqui. Update/delete NEGADOS ao cliente:
    // somente o Console/Admin muda o status depois do create.
    match /withdrawals/{withdrawalId} {
      allow read: if isSignedIn()
        && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && (request.resource.data.status == 'pending'
            || request.resource.data.status == 'completed'
            || request.resource.data.status == 'failed');
      allow update, delete: if false;
    }

    // ---- Intenções de RECOMPENSA POR ANÚNCIO: cliente só CRIA a intenção --
    // Criada SOMENTE após onUserEarnedReward do SDK (anúncio sempre iniciado
    // pelo usuário). Campos EXATOS {uid,type:'rewarded',adUnitId,
    // clientRequestId,createdAt,clientVersion}; doc id = clientRequestId ⇒
    // retry offline reescreve o MESMO doc (idempotência; update é negado).
    // A CONCESSÃO é EXCLUSIVAMENTE do runner (limite diário + cooldown +
    // antifraude no backend) — nunca pelo cliente.
    match /adRewardIntents/{intentId} {
      allow read: if isSignedIn()
        && resource.data.uid == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(
              ['uid', 'type', 'adUnitId', 'clientRequestId', 'createdAt',
               'clientVersion'])
        && request.resource.data.type == 'rewarded'
        && request.resource.data.adUnitId is string
        && request.resource.data.adUnitId.size() > 0
        && request.resource.data.adUnitId.size() <= 128
        && request.resource.data.clientRequestId == intentId
        && request.resource.data.clientRequestId.size() >= 8
        && request.resource.data.clientRequestId.size() <= 128
        && request.resource.data.clientVersion is string
        && request.resource.data.clientVersion.size() <= 32
        && withinTolerance(request.resource.data.createdAt);

      allow update, delete: if false;
    }

    // ---- Recompensas de anúncio CONCEDIDAS: espelho escrito SOMENTE pelo
    // runner (Admin SDK). Leitura apenas do dono — alimenta o contador
    // diário "X de Y hoje" da LOJA.
    match /adRewards/{rewardId} {
      allow read: if isSignedIn()
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ---- Rate limits: mantidos pelo backend; leitura apenas do dono -----
    match /rateLimits/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ---- Grants temporários: somente backend ----------------------------
    match /tempGrants/{grantId} {
      allow read: if isSignedIn()
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ---- Check-in diário (14.11-FIX2): dono CRIA o doc do dia -------------
    // checkins/{uid}/{yyyy-MM-dd} — idempotente (set sem merge reescreve o
    // MESMO doc). O estado real das máquinas vive em users/{uid}.lastCheckinAt
    // (fonte única); este doc é apenas o registro diário.
    match /checkins/{uid}/{date} {
      allow read, create: if isOwner(uid);
      allow update, delete: if false;
    }

    // ---- Blocos e transações: leitura pública/dono, escrita backend -----
    match /blocks/{periodKey} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /transactions/{txId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /rewards/{rewardId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ---- Histórico de recompensas: espelho escrito SOMENTE pelo backend --
    // `rewards/{uid}` é doc-agregador; as entradas vivem na SUBCOLEÇÃO items.
    // Subcoleções exigem match PRÓPRIO (a regra do doc pai NÃO vale para
    // elas — sem isto o catch-all negava com PERMISSION_DENIED). O runner
    // grava {type, amount, currencyId, createdAt, referenceId} ao creditar
    // (GAME_REWARD / REWARD_BLOCK); cliente lê como owner, nunca escreve.
    // 14.11 — EXCEÇÃO: o DONO pode CRIAR (nunca atualizar/deletar) a entrada
    // REWARD_OFFLINE da coleta offline, na MESMA transação do aumento de
    // saldo da wallet (campos exatos; amount int ≤ teto da rule).
    // 14.11-FIX2: payload do OfflineMiningService — amount INT, periodFrom/
    // periodTo (chaves epoch-based do runner), createdAt timestamp.
    match /rewards/{uid}/items/{itemId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.type == 'REWARD_OFFLINE'
        && request.resource.data.keys().hasOnly(
              ['type', 'amount', 'periods', 'createdAt',
               'periodFrom', 'periodTo'])
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1500000000
        && request.resource.data.periods is int
        && request.resource.data.periods > 0
        && request.resource.data.periods <= 288
        && request.resource.data.periodFrom is string
        && request.resource.data.periodTo is string
        && withinTolerance(request.resource.data.createdAt);
      allow update, delete: if false;
    }

    // ---- Config interna: catálogo de máquinas legível; economia fechada --
    // config/catalog/machines/{id}: 4 segmentos (par obrigatório p/ docs).
    match /config/catalog/machines/{machineId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // config/economy: LEITURA autenticada (cliente exibe machineSlots da
    // sala); escrita SOMENTE backend. Nenhum campo é decisão do cliente.
    match /config/economy {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // config/payouts: LEITURA autenticada (carteira exibe ativos habilitados,
    // mínimos e taxas — rótulo "valores definidos pelo servidor"); escrita
    // SOMENTE backend/seed. Nenhum campo é decisão do cliente.
    match /config/payouts {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // config/ads: LEITURA autenticada (LOJA exibe o limite diário de vídeos);
    // escrita SOMENTE backend/seed. Nenhum campo é decisão do cliente.
    match /config/ads {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /config/{docId} {
      allow read, write: if false;
    }

    // ---- Auditoria: acesso somente via backend ---------------------------
    match /auditLogs/{logId} {
      allow read, write: if false;
    }

    // ---- Catch-all: NEGAR tudo que não foi explicitamente permitido ------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
